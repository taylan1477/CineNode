# CineNode Ortam Değişkenleri

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_TELEGRAM_USER_IDS=12345678,87654321

# Plex Ayarları
PLEX_BASE_URL=http://localhost:32400
PLEX_TOKEN=your_plex_token_here
# Time sharing grupları (Plex e-posta adresleri virgülle ayrılmış)
PLEX_USERS_WORKERS=user1@gmail.com,user2@gmail.com
PLEX_USERS_UNEMPLOYED=user3@gmail.com,user4@gmail.com

# Radarr Ayarları
RADARR_BASE_URL=http://localhost:7878
RADARR_API_KEY=your_radarr_api_key_here
RADARR_ROOT_FOLDER_PATH=/data/movies
RADARR_QUALITY_PROFILE_ID=1

# qBittorrent Ayarları
QBIT_HOST=localhost
QBIT_PORT=8080
QBIT_USER=admin
QBIT_PASS=adminadmin
